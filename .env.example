# Optional — only used for AI lyrics generation (Lyrics tab).
# App runs fully without it; users can write lyrics manually.
ANTHROPIC_API_KEY=sk-ant-...

# Beats, melody, chords, instruments are all generated client-side (Tone.js).
# No music-AI API key needed.

DATABASE_URL=sqlite+aiosqlite:///./voxai.db
UPLOAD_DIR=uploads
